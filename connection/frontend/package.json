{
  "name": "connection-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "concurrently 'panda codegen' 'pnpm orval'",
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "concurrently --group --timings 'pnpm:eslint:fix' 'pnpm:typecheck'",
    "lint": "concurrently --group --timings 'pnpm:eslint' 'pnpm:typecheck'",
    "orval": "orval --config ./orval/v1/config.ts"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "printWidth": 100,
    "semi": true,
    "useTabs": false,
    "tabWidth": 2
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.1.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.13.23",
    "antd": "^6.3.5",
    "import-in-the-middle": "^3.0.0",
    "jotai": "^2.19.0",
    "jotai-location": "^0.6.2",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-navigation-guard": "^0.2.0",
    "rbush": "^4.0.1",
    "react": "19.2.4",
    "react-arborist": "^3.4.3",
    "react-dom": "19.2.4",
    "react-use": "^17.6.0",
    "require-in-the-middle": "^8.0.1",
    "url-join": "^5.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.2",
    "@pandacss/dev": "^1.9.1",
    "@parcel/watcher": "^2.5.6",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@uvarovag/eslint-config-feature-sliced-flat": "^1.0.11",
    "agentation": "^3.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "csstype": "^3.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "orval": "^8.6.2",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "typescript": "^5"
  }
}
